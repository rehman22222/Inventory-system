    "s_rails": "وسائل الدفع"
  },
  "features": {
    "label": "المزايا",
    "title": "ستة أنظمة. مصدر واحد للحقيقة.",
    "intro": "المخزون والمبيعات والمشتريات والفريق — من منصة واحدة تتحدّث لحظة حدوث أي تغيير. لا جداول بيانات للمطابقة، ولا علامات تبويب للمزامنة.",
    "items": [
      {
        "title": "تتبّع المخزون الفوري",
        "desc": "كل عملية بيع أو نقل أو إرجاع تُحدّث الأعداد في اللحظة ذاتها. تنبيهات انخفاض المخزون تصل قبل نفاده — لا بعد أن يخبرك زبون غاضب."
      },
      {
        "title": "وصول قائم على الأدوار",
        "desc": "يرى المدير والمشرف والموظف نطاق عملهم بالضبط ولا شيء غيره. الصلاحيات مطبّقة على كل مسار من جهة الخادم، وليست مجرد مخفية في الواجهة."
      },
      {
        "title": "نقطة بيع مدمجة",
        "desc": "امسح، احصِّل، اطبع. نقدًا أو بطاقة أو تحويلًا بنكيًا أو Easypaisa أو JazzCash — ويُخصم المخزون تلقائيًا لحظة إتمام البيع."
      },
      {
        "title": "المبيعات والتحليلات",
        "desc": "الإيرادات والأكثر مبيعًا والأرباح على رسوم بيانية حيّة. صدّر جدول بيانات نظيفًا لأي نطاق تاريخي بنقرة واحدة."
      },
      {
        "title": "المورّدون والطلبات",
        "desc": "تتبّع مَن يورّد ماذا، وأنشئ أوامر الشراء، وطابِق المخزون الوارد مع التسليمات — دورة الشراء كاملة على شاشة واحدة."
      },
      {
        "title": "سجل نشاط كامل",
        "desc": "مَن غيّر ماذا ومتى ومن أي عنوان IP. كل إجراء موثّق بالوقت والاسم، فلا يحدث شيء في النظام دون تسجيل."
      }
    ]
  },
  "workflow": {
    "label": "سير العمل",
    "title": "جاهز خلال بعد الظهر. لا خلال ربع سنة.",
    "intro": "لا إعداد يستغرق ستة أسابيع. حمّل كتالوجك، وابدأ البيع، واقرأ أرقامك في اليوم نفسه — ثلاث خطوات، بالترتيب.",
    "steps": [
      {
        "title": "جهّز كتالوجك",
        "desc": "استورد المنتجات والفئات والمورّدين دفعة واحدة، أو أضِفها تباعًا. الباركود اختياري. متجرك يعمل في بعد الظهر نفسه — لا في الربع القادم."
      },
      {
        "title": "أدِر يومك",
        "desc": "بِع عبر نقطة البيع، وانقل المخزون بين الرفوف، وأنشئ أوامر الشراء. يعمل الفريق كله في مكان واحد وتبقى الأعداد دقيقة تلقائيًا."
      },
      {
        "title": "اقرأ المؤشرات",
        "desc": "راقب الإيرادات والأرباح وانخفاض المخزون فوريًا. صدّر الأرقام التي يطلبها محاسبك عند الحاجة — دون جمع يدوي."
      }
    ]
  },
  "system": {
    "label": "النظام",
    "title": "مبني كبنية تحتية،",
    "accent": "لا كجدول بيانات.",
    "intro": "الأجزاء التي تُبقي بياناتك صحيحة وفريقك مسؤولًا — مصمّمة من الأساس، لا مُضافة لاحقًا.",
    "specs": [
      "JWT في كوكيز HTTP-only، محميّة بالأدوار على كل مسار.",
      "Socket.IO يدفع المخزون والطلبات والتنبيهات إلى كل جلسة مفتوحة.",
      "MongoDB مع بديل تخزين محلي للعدّ دون اتصال.",
      "تقارير .xlsx منسّقة للمبيعات والمخزون والتدقيق — لأي نطاق.",
      "سجل تدقيق كامل، موثّق بعنوان IP، غير قابل للتعديل بعد كتابته."
    ]
  },
  "faq": {
    "label": "الأسئلة",
    "title": "إجابات، موثّقة.",
    "helpPre": "ما زلت تفكّر؟ راسِلنا على",
    "helpLink": "support@e360.app",
    "items": [
      {
        "q": "ما هو E360 بالضبط؟",
        "a": "نظام واحد لأعمال المنتجات: مخزون فوري، ونقطة بيع مدمجة، وتحليلات، وإدارة موردين وطلبات، ووصول متعدد الأدوار، وسجل تدقيق كامل — دون أي إضافات."
      },
      {
        "q": "ما الأدوار المدعومة؟",
        "a": "ثلاثة، لكلٍّ صلاحيات محددة: المدير (النظام كاملًا)، والمشرف (المخزون والتقارير والموردون)، والموظف (نقطة البيع والعمليات اليومية). الأدوار مطبّقة على الخادم."
      },
      {
        "q": "هل يتضمّن نقطة بيع؟",
        "a": "نعم. تدعم نقطة البيع مسح الباركود، وخمس وسائل دفع (نقد، بطاقة، تحويل بنكي، Easypaisa، JazzCash)، والإيصالات، وخصم المخزون تلقائيًا عند الدفع."
      },
      {
        "q": "هل يعمل دون إنترنت؟",
        "a": "يُبقي وضع التخزين المحلي العدّ يعمل دون اتصال. الوضع الافتراضي يستخدم قاعدة بيانات سحابية وتحديثات Socket.IO الفورية عبر الجلسات."
      },
      {
        "q": "هل هناك تجربة مجانية؟",
        "a": "نعم — سجّل واستخدم كل ميزة دون بطاقة ودون قيود مصطنعة خلال التجربة."
      }
    ]
  },
