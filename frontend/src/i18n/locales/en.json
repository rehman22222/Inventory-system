    "faq": {
      "barcode": {
        "q": "A barcode does not scan — what do I do?",
        "a": "Scan it anyway. The till will tell you the barcode is unknown and offer to link it to an existing product or create a new one. Once linked, that barcode works forever."
      },
      "refund": {
        "q": "How do I refund only part of a receipt?",
        "a": "POS → Refund Transaction → enter the receipt number → set the quantity to return on each line. Stock goes back automatically and the receipt is marked partially refunded."
      },
      "voucher": {
        "q": "How do I create a discount code?",
        "a": "Vouchers page (admin/manager). Choose a fixed € amount or a percentage, set a minimum spend, expiry and usage limit. The cashier applies it from the POS Vouchers button."
      },
      "users": {
        "q": "How do I add a cashier?",
        "a": "Users page → Add a user → choose the Staff role. Staff can only see the dashboard and the till."
      },
      "reports": {
        "q": "Why does my report show a negative row?",
        "a": "That is a refund. Refunds are recorded as negative sales so revenue, cost and profit all net out correctly."
      },
      "offline": {
        "q": "The site is slow to load first thing in the morning.",
        "a": "The server sleeps when idle on the free hosting tier and takes a few seconds to wake. Raise a ticket if you want us to move it to an always-on plan."
      }
