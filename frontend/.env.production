# Used by `npm run build` (production). The app is served by the same Express
# server it talks to, so the API is same-origin — point it at the public URL.
REACT_APP_BACKEND_URL=https://inventory.eiretech360.com
GENERATE_SOURCEMAP=false
# Don't treat build warnings as errors on CI-style hosts (e.g. Hostinger).
CI=false
