# Production build (`npm run build`). The app is served by its own Express
# backend, so the API is same-origin — we deliberately DON'T set
# REACT_APP_BACKEND_URL, so axios/socket use a relative path / the current
# origin. That makes the same build work on the final domain and on the
# temporary Hostinger URL alike.
# Explicitly blank (not omitted) so it OVERRIDES the localhost value in .env —
# CRA loads .env as a fallback, so leaving this out would bake localhost:3003
# into the production bundle. Empty => axios/socket use a relative / same-origin
# URL.
REACT_APP_BACKEND_URL=
GENERATE_SOURCEMAP=false
# Don't treat build warnings as errors on CI-style hosts (e.g. Hostinger).
CI=false

# ── SEO ────────────────────────────────────────────────────────────────────
# The canonical, public origin of THIS deployment, with no trailing slash.
# Used for the canonical URL, og:url, the JSON-LD, and sitemap.xml.
#
# SET THIS BEFORE THE FIRST PRODUCTION BUILD. Left blank, the app falls back to
# whatever origin serves the page (so nothing breaks), but sitemap.xml is not
# generated and Search Console has nothing to verify against.
REACT_APP_SITE_URL=https://e360pro.com

# "false" keeps this whole deployment out of Google: robots.txt becomes a
# blanket Disallow and every page renders noindex.
#
# Set it to "false" on any per-shop instance. Only the public marketing
# deployment should be crawlable — otherwise every shop's copy of this landing
# page competes with the real one for the same terms, and private instances
# start showing up in search results.
REACT_APP_SEO_INDEXABLE=true
