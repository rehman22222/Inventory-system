# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Neither variable is VITE_-prefixed, and that is deliberate: Vite only exposes
# VITE_* to the browser bundle. These are read on the server only, inside the
# server functions in src/lib/catalog-api.ts.

# Where the storefront reaches the E360 inventory backend.
# Production: https://e360pro.com
E360_API_URL=http://localhost:3003

# Shared secret presented on /api/storefront/* as the x-storefront-key header.
# Must be identical to STOREFRONT_API_KEY in the backend's environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STOREFRONT_API_KEY=
